{
  "name": "dsh-plugin-recycle-bin",
  "description": "Enforce recycle-bin-only deletion on Windows: block del/rm/Remove-Item and other disk-erase commands, forbid automatically emptying the recycle bin, and stop + ask the user when the recycle bin or disk is full.",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./guard": "./lib/guard.js",
    "./extract": "./lib/extract.js",
    "./recycle": "./lib/recycle.js",
    "./package.json": "./package.json"
  },
  "types": "lib/index.d.ts",
  "license": "MIT",
  "scripts": {
    "test": "node test-guard.mjs"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "cordis.example.yml",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.0.1",
    "node": ">=20.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "recycle-bin",
    "windows",
    "delete-guard",
    "safety",
    "trash"
  ]
}
